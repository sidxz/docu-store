# docu-store — Production Environment Configuration
#
# Copy to .env.prod and fill in secrets:
#   cp .env.prod.example .env.prod
#
# Deployment (two stacks):
#   1. docker stack deploy -c docker-compose.infra.yml docu-store-infra
#   2. docker stack deploy -c docker-compose.prod.yml docu-store
#
# This file is read by docker-compose.prod.yml via env_file.
# Service DNS names (mongo, kafka, temporal, etc.) are set in the compose
# environment block — you do NOT need to set connection URIs here.

# ── Application ─────────────────────────────────────────────
APP_NAME=DocuStore
APP_ENV=production
LOG_LEVEL=INFO

# ── Ports (host-side, customizable) ────────────────────────
API_PORT=8000
WEB_PORT=15000
# ESDB_PORT=2113
# TEMPORAL_PORT=7233
# QDRANT_PORT=6333
# TEMPORAL_UI_PORT=8233
# KAFKA_UI_PORT=5051
# QDRANT_UI_PORT=6334

# ── Image version (default: latest) ────────────────────────
# VERSION=0.1.0

# ── Temporal Postgres ───────────────────────────────────────
# Generate: openssl rand -base64 24
TEMPORAL_POSTGRES_PASSWORD=

# ── Temporal Concurrency ────────────────────────────────────
# Increase for production hardware. Ollama LLM: keep at 1-2. Cloud API: 5-10.
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=5
TEMPORAL_MAX_CONCURRENT_LLM_ACTIVITIES=2

# ── Duar Auth ───────────────────────────────────────────
DUAR_URL=https://duar.example.com
# Generate from Duar admin panel
DUAR_SERVICE_KEY=
DUAR_SERVICE_NAME=docu-store
DUAR_IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ── LLM Provider ───────────────────────────────────────────
# Options: ollama, openai, gemini
LLM_PROVIDER=ollama
LLM_MODEL_NAME=gemma3:27b
LLM_BASE_URL=http://ollama:11434
# LLM_API_KEY=                   # required for openai/gemini

# Chat LLM (optional override — defaults to batch LLM settings)
# CHAT_LLM_PROVIDER=
# CHAT_LLM_MODEL_NAME=
# CHAT_LLM_BASE_URL=
# CHAT_LLM_API_KEY=

# ── Blob Storage ────────────────────────────────────────────
# Uploads and page images. Local filesystem: the shared `blobs` volume in
# docker-compose.prod.yml (single node; see the note there for multi-node).
BLOB_BASE_URL=file:///data/blobs

# S3 (or MinIO / R2). Credentials from these or an IAM role; AWS_ENDPOINT_URL
# only for S3-compatible services.
# BLOB_BASE_URL=s3://your-bucket/docu-store
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=https://minio.example.com

# Azure Blob Storage. Account name + key, a connection string, or the account
# name alone to sign in with a managed identity.
# BLOB_BASE_URL=az://your-container/docu-store
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONNECTION_STRING=

# Extra fsspec storage options as JSON (override the variables above):
# BLOB_STORAGE_OPTIONS={}

# Cap on each workspace's uploaded bytes, in MiB (set it for self-serve).
# Workspace admins can set a lower limit, never a higher one. Unset = no cap.
# MAX_WORKSPACE_STORAGE_MB=500

# ── Qdrant Cloud (optional — default uses local Qdrant) ────
# QDRANT_API_KEY=

# ── Langfuse (LLM Observability — infra stack) ─────────────
# These are used by the app to connect to Langfuse.
PROMPT_REPOSITORY_TYPE=langfuse
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Langfuse Infrastructure (infra stack internal) ─────────
# Generate passwords: openssl rand -base64 24
LANGFUSE_PG_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_ENCRYPTION_KEY=
# Langfuse admin user (pre-seeded on first start)
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_NAME=admin
LANGFUSE_ADMIN_PASSWORD=
# LANGFUSE_URL=https://langfuse.example.com
# LANGFUSE_PORT=3000

# ── Umami (Web Analytics — infra stack) ────────────────────
# Generate: openssl rand -base64 24
UMAMI_PG_PASSWORD=
# UMAMI_PORT=3001
# UMAMI_TRACKER_SCRIPT=ds-analytics

# ── Embeddings ──────────────────────────────────────────────
# Device is forced to cpu in compose environment block.
# Override model names only if using different embedding models.
# EMBEDDING_MODEL_NAME=ibm-granite/granite-embedding-english-r2  # change ⇒ re-embed all documents
# EMBEDDING_DIMENSIONS=768
# SMILES_EMBEDDING_MODEL_NAME=DeepChem/ChemBERTa-77M-MTR

# ── Plugins (optional) ─────────────────────────────────────
# Comma-separated list of plugin package names
# ENABLED_PLUGINS=

# ── Frontend Runtime Config ─────────────────────────────────
# Read by the web container at runtime via /api/config endpoint.
# No build-time baking — one image works across all environments.
APP_API_URL=https://api.example.com
APP_URL=https://app.example.com
APP_DUAR_URL=https://duar.example.com
# APP_SELF_SERVE_ENABLED=true   # public edition only — shows sign-up/invite links; requires Duar SELF_SERVE_ENABLED=true
# APP_LITERATURE_ENABLED=true   # offers Literature Search; requires services LITERATURE_ENABLED=true
APP_GOOGLE_CLIENT_ID=
APP_GITHUB_CLIENT_ID=
# APP_ENTRA_ID_CLIENT_ID=
# APP_UMAMI_URL=https://umami.example.com
# APP_UMAMI_WEBSITE_ID=
